# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/freshleaf?retryWrites=true&w=majority
MONGODB_URI=

# Port for server (Dev server in AI Studio uses port 3000)
PORT=3000

# JWT Authentication Secret
JWT_SECRET=freshleaf_super_secret_jwt_key_2026

# Client application URL
CLIENT_URL=http://localhost:3000

# Optional Gemini API Key
GEMINI_API_KEY=
